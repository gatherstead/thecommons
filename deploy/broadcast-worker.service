# Broadcast Playwright worker — copy to /etc/systemd/system/broadcast-worker.service
# then: sudo systemctl daemon-reload && sudo systemctl enable --now broadcast-worker
#
# Drains the dedicated `broadcast` queue (broadcast.tasks, routed via
# CELERY_TASK_ROUTES in backend/settings/base.py) and drives bundled Chromium —
# one submission at a time, sequential targets. Chromium lives in
# /home/ubuntu/.cache/ms-playwright/ (installed via `uv run playwright install
# chromium` as the ubuntu user — NEVER "chrome").
#
# -c 1 is mandatory, not a tuning default: recover_orphans() assumes a single
# worker (any 'running' submission at startup is necessarily orphaned), so
# concurrency > 1 would let a live queue-drain race orphan recovery.

[Unit]
Description=The Commons broadcast worker (Playwright form-filler)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/thecommons/backendServer
EnvironmentFile=/home/ubuntu/thecommons/backendServer/.env
# .venv/bin/celery, not `uv run` — see celery.service for why: `uv run`
# through snap put this unit's process in a user-scope that a logout could
# tear down. Execing the venv binary directly removes that mechanism.
ExecStart=/home/ubuntu/thecommons/backendServer/.venv/bin/celery -A backend worker -Q broadcast -c 1 -l info
# Restart=always is belt-and-braces (see celery.service) in case this unit
# is ever reverted to `uv run` or linger (DEPLOY.md) is ever lost.
Restart=always
RestartSec=5
# Screenshot/download dirs (BROADCAST_SCREENSHOT_DIR / BROADCAST_DOWNLOAD_DIR
# in .env) must be writable by ubuntu, e.g. /home/ubuntu/broadcast/.
# Chromium is memory-heavy on the 6 GB VM — cap the worker so a leak can't
# take down gunicorn/nextjs.
MemoryMax=2G

[Install]
WantedBy=multi-user.target
