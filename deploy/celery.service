# Celery worker — copy to /etc/systemd/system/celery.service
# then: sudo systemctl daemon-reload && sudo systemctl enable --now celery
#
# Mirrors the gunicorn pattern: ExecStart execs the venv binary directly
# instead of going through `uv run`, so this unit never lands in a snap
# user-scope (see the ExecStart comment below). Drains the Redis broker
# (DB 0, REDIS_URL in .env) and runs tasks autodiscovered from each app's
# tasks.py. Concurrency=2 is a guess for the 1 OCPU / 6 GB VM and a
# network-bound task mix (LLM + email) — tune after observing prod load.

[Unit]
Description=The Commons Celery worker
After=network.target redis-server.service
Requires=redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/thecommons/backendServer
EnvironmentFile=/home/ubuntu/thecommons/backendServer/.env
# .venv/bin/celery, NOT `/snap/bin/uv run celery`: snap-packaged uv runs its
# child inside a transient scope under user@1001.service (the *user* manager,
# not this unit's own cgroup), so a logout that tears down user-1001.slice
# (linger off) took the whole async stack down silently for 8 days from
# 2026-07-21 — clean exit, status=0/SUCCESS, so Restart=on-failure declined to
# restart it. Execing the venv binary directly removes that mechanism
# entirely, the same way gunicorn (which never went through snap) stayed up
# 68 days straight through the incident. See DEPLOY.md and
# docs/prod-incident-2026-07-21-scheduler-outage.md for the full writeup.
ExecStart=/home/ubuntu/thecommons/backendServer/.venv/bin/celery -A backend worker -l info --concurrency=2
# Restart=always is belt-and-braces, not the primary fix: if this unit is
# ever reverted to `uv run` or `loginctl enable-linger ubuntu` (DEPLOY.md) is
# ever lost, a logout-driven exit is still status=0/SUCCESS, which
# on-failure would not restart.
Restart=always
RestartSec=5
MemoryMax=1G

[Install]
WantedBy=multi-user.target
