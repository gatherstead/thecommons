# Celery beat scheduler — copy to /etc/systemd/system/celerybeat.service
# then: sudo systemctl daemon-reload && sudo systemctl enable --now celerybeat
#
# Exactly one beat process (Celery best practice). Uses django-celery-beat's
# DatabaseScheduler, so the schedule lives in Postgres (editable in the admin)
# and beat needs no pidfile or RuntimeDirectory.

[Unit]
Description=The Commons Celery beat (scheduler)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/thecommons/backendServer
EnvironmentFile=/home/ubuntu/thecommons/backendServer/.env
# .venv/bin/celery, not `uv run` — see celery.service for why: `uv run`
# through snap put this unit's process in a user-scope that a logout could
# tear down, exiting beat status=0/SUCCESS and never triggering a restart.
# That's why `ingest-events-daily` fired only twice in its lifetime and
# `scrape-sources-daily` never — beat rarely survived to its 3:30/4:00am
# cron slot. Execing the venv binary directly removes the mechanism.
ExecStart=/home/ubuntu/thecommons/backendServer/.venv/bin/celery -A backend beat -l info
# Restart=always is belt-and-braces (see celery.service) in case this unit
# is ever reverted to `uv run` or linger (DEPLOY.md) is ever lost.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
