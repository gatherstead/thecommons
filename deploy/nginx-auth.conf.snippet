# Auth-origin server block — ADD to the existing single config file
# /etc/nginx/sites-available/thecommons (do NOT create a separate
# sites-available file; the repo convention is one file, many server blocks).
#
# PREREQUISITES (in order):
#   1. Cloudflare DNS: A record `auth` → 129.80.229.41, proxied (orange cloud)
#      — A record like the others, not a CNAME.
#   2. Cert must cover the subdomain — wildcard `*.thecommons.town` (or
#      `thecommons.town, *.thecommons.town`) at
#      /etc/ssl/cloudflare/thecommons.town.{pem,key}. Without this the
#      subdomain 526s at Cloudflare.
# Then: sudo nginx -t && sudo systemctl reload nginx
#
# See docs/runbook-auth-cutover.md for the full cutover (env vars, forced
# re-login note, etc.) — this snippet only covers the nginx routing piece.

server {
    listen 443 ssl;
    server_name auth.thecommons.town;

    ssl_certificate     /etc/ssl/cloudflare/thecommons.town.pem;
    ssl_certificate_key /etc/ssl/cloudflare/thecommons.town.key;

    location / {
        proxy_pass         http://localhost:3000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }
}

# The HTTP→HTTPS redirect block already catches port 80 for *.thecommons.town
# if it uses a wildcard server_name; if it lists hostnames explicitly, add
# auth.thecommons.town there too (same as broadcast.thecommons.town).
#
# Better Auth is still physically served by the same Next.js app on :3000 —
# this block just gives it its own routable origin.
