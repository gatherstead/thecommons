# Ingestion scrape worker — copy to /etc/systemd/system/scrape-worker.service
# then: sudo systemctl daemon-reload && sudo systemctl enable --now scrape-worker
#
# Drains the dedicated `scrape` queue (ingestion.tasks.scrape_all_sources_task,
# routed via CELERY_TASK_ROUTES in backend/settings/base.py). That task renders
# headless Chromium and is memory-heavy, so it gets its own worker — this keeps
# browser memory off the default `celery` worker entirely.

[Unit]
Description=The Commons scrape worker (Playwright ingestion scraper)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/thecommons/backendServer
EnvironmentFile=/home/ubuntu/thecommons/backendServer/.env
# Chromium is installed via `uv run playwright install chromium` as the ubuntu
# user into ~/.cache/ms-playwright/ — shared with broadcast-worker, so no extra
# download if it's already installed. NEVER a branded "chrome" channel —
# unsupported on arm64.
# .venv/bin/celery, not `uv run` — see celery.service for why: `uv run`
# through snap put this unit's process in a user-scope that a logout could
# tear down. Execing the venv binary directly removes that mechanism.
# -n commons-scrape@%%h — unique nodename so `inspect`/`control` can address this
# worker specifically. `%%h` (doubled) passes a literal `%h` to celery; a bare
# %h is a systemd specifier for the user home dir. See celery.service.
ExecStart=/home/ubuntu/thecommons/backendServer/.venv/bin/celery -A backend worker -Q scrape -n commons-scrape@%%h -c 1 -l info
# Restart=always is belt-and-braces (see celery.service) in case this unit
# is ever reverted to `uv run` or linger (DEPLOY.md) is ever lost.
Restart=always
RestartSec=5
# Headless Chromium is memory-heavy on the 6 GB VM — cap the worker so a leak
# can't take down gunicorn/nextjs/celery.
MemoryMax=2G

[Install]
WantedBy=multi-user.target
