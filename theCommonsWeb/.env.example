# ── Django API ───────────────────────────────────────────────────────────────
# URL of the Django backend. Defaults to http://127.0.0.1:8000 if unset —
# you only need this if you run Django on a different port or use a staging URL.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_THE_COMMONS_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Same Neon connection string as backendServer/.env. Better Auth owns the
# `neon_auth` schema; Django reads from `public`. Both point at the same DB.
DATABASE_URL=

# ── Better Auth ──────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET: any random string (e.g. `openssl rand -hex 32`).
# BETTER_AUTH_URL / NEXT_PUBLIC_BETTER_AUTH_URL: the origin where Better Auth
# is served. In dev this is the local Next.js dev server. In prod the auth app
# sits behind a reverse proxy at https://auth.thecommons.town.
#   dev:  http://localhost:3000
#   prod: https://auth.thecommons.town
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# BETTER_AUTH_COOKIE_DOMAIN — set ONLY in prod to enable cross-subdomain
# session cookies shared across *.thecommons.town. Leave unset in dev; when
# unset the cookie config is untouched (localhost-scoped, SameSite=Lax).
#   dev:  (unset)
#   prod: .thecommons.town
# BETTER_AUTH_COOKIE_DOMAIN=.thecommons.town

# BETTER_AUTH_TRUSTED_ORIGINS — optional comma-separated list of additional
# origins to trust (beyond the five hardcoded in src/lib/auth.ts). Also read
# natively by better-auth itself, so no code changes are needed to add more.
# BETTER_AUTH_TRUSTED_ORIGINS=

# BREVO_API_KEY / DIGEST_FROM_EMAIL — required in prod for the password-reset
# email (emailAndPassword.sendResetPassword in src/lib/auth.ts). Same Brevo
# account/sender as backendServer's email_service.py, called directly via the
# Brevo REST API since there's no shared email helper across the two apps.
# Without BREVO_API_KEY set, /forgot-password still responds success (Better
# Auth's anti-enumeration behavior) but no email actually goes out — logged,
# not thrown.
#
# DIGEST_FROM_EMAIL must be an address Brevo has validated — either a verified
# sender or an address at an authenticated domain. An unvalidated sender fails
# *silently*: Brevo returns 201 Created, so the res.ok check in auth.ts passes
# and nothing is logged, but the message is rejected during async processing
# and never delivered. Keep this in step with backendServer/.env — they must
# both use a validated sender, and drift between them is invisible from the
# browser. The only place the rejection surfaces is Brevo's event log:
#   GET https://api.brevo.com/v3/smtp/statistics/events?email=<recipient>&days=7
# thecommons.town was authenticated in Brevo (DKIM/SPF via Cloudflare) on 2026-08-17,
# so @thecommons.town senders are valid. If that authentication ever lapses, sends
# revert to the silent rejection described above.
BREVO_API_KEY=
DIGEST_FROM_EMAIL=digest@thecommons.town
